[Unit]
Description=piway agent
# Start after rootless Docker is ready (its unit is Type=notify): piway
# looks for the daemon once, at startup, and turns deploys off without it.
# Ordering only; a Pi without Docker still starts piway.
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Settings come from ~/.config/piway/config.yaml (see docs/CONFIG.md).
# Avoid flags here: they override the file and environment.
ExecStart=%h/.local/bin/piway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
